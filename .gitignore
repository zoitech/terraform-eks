# Local .terraform directories
**/.terraform/*
.terraform.*
.terraform

# Crash log files
crash.log

# .tfstate files
*.tfstate
*.tfstate.*

# .tfvars files
*.tfvars
!examples/**/terraform.tfvars

# provider files
provider.tf
!examples/**/provider.tf

# Ignore override files as they are usually used to override resources locally and so
# are not checked in
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Lambda build artifacts
builds/
__pycache__/
*.zip
.tox

# Local editors/macos files
.DS_Store
.idea
